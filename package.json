{
	"name": "@liiift-studio/opticalmargin",
	"version": "1.0.18",
	"description": "Font-metric hanging punctuation — cross-browser optical margin alignment using actual glyph bounds, not a lookup table",
	"type": "module",
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "vite build",
		"build:webflow": "vite build --config vite.webflow.config.ts",
		"test": "vitest",
		"test:run": "vitest run",
		"capture": "node scripts/capture.mjs",
		"lint": "tsc --noEmit",
		"prepublishOnly": "npm run test:run && npm run build && npm run build:webflow"
	},
	"peerDependencies": {
		"react": ">=17",
		"react-dom": ">=17"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		}
	},
	"devDependencies": {
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/react": "^19.0.0",
		"@vitejs/plugin-react": "^4.0.0",
		"happy-dom": "^20.10.6",
		"next": "16.2.2",
		"react": "^19.0.0",
		"typescript": "^5.0.0",
		"vite": "^6.0.0",
		"vite-plugin-dts": "^4.0.0",
		"vitest": "^3.0.0"
	},
	"keywords": [
		"typography",
		"web-typography",
		"frontend",
		"liiift-studio",
		"optical-margin",
		"hanging-punctuation",
		"punctuation",
		"indent",
		"margin-alignment",
		"font-metrics",
		"canvas",
		"cross-browser",
		"typesetting",
		"zero-dependencies",
		"react",
		"typescript",
		"css"
	],
	"author": "Quinn Keaveney <quinn@liiift.studio>",
	"license": "MIT",
	"homepage": "https://opticalmargin.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Liiift-Studio/OpticalMargin.git"
	},
	"bugs": {
		"url": "https://github.com/Liiift-Studio/OpticalMargin/issues"
	},
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	}
}
